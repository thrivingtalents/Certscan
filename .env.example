# Copy this file to .env and fill it in.

# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_PASSWORD=change-me

# The public address of this app. Used inside QR codes and email links.
BASE_URL=https://cert.yourdomain.com
APP_NAME=CertQR
# Time zone for times shown in the admin panel and CSV export
DISPLAY_TZ=Asia/Kuala_Lumpur

# ---- Email (leave SMTP_HOST empty to save emails to data/outbox instead of sending) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=Your Event <certificates@yourdomain.com>
MAIL_REPLY_TO=
# Pause between emails, in seconds. Raise it if your provider rate-limits you.
MAIL_SEND_INTERVAL=0.5

# Registrations allowed per IP address per minute
REGISTER_LIMIT_PER_MIN=10
MAX_UPLOAD_MB=15
